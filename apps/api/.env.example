# Copie para .env ou gere automaticamente com:  python -m app.cli init
# NUNCA versione o arquivo .env real.

# development | production | test
ENVIRONMENT=development

# Banco de dados. Padrão: SQLite local em apps/api/data/metlife_crm.db
# Para PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/metlife_crm
# DATABASE_URL=sqlite:///./data/metlife_crm.db

# Assinatura das sessões (JWT). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Criptografia de campos sensíveis (CPF). Chave Fernet.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Chave do HMAC usado para deduplicar candidatos pelo CPF sem armazená-lo em claro.
CPF_HASH_KEY=

# Duração da sessão, em horas
SESSION_HOURS=8

# true quando servido via HTTPS (obrigatório em produção)
COOKIE_SECURE=false

# Exibe a faixa "DADOS DE DEMONSTRAÇÃO" em toda a interface
DEMO_MODE=true
